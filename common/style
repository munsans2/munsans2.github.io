@font-face{font-family:SeoulNamsan;src:url(https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_two@1.0/SeoulNamsanM.woff) format('woff');font-display:swap}
:root{--ink:#22354a;--muted:#6b7b8d;--glass:rgba(255,255,255,.87);--outline:rgba(255,255,255,.9);--shadow:0 12px 35px rgba(33,65,99,.11)}
*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden}
body{font-family:SeoulNamsan,'Noto Sans KR',system-ui,sans-serif;color:var(--ink);background:#eaf2fa}
canvas{display:block;position:fixed;inset:0;touch-action:none;outline:none}
button,input{font:inherit}button{cursor:pointer;color:inherit}a{color:inherit;text-decoration:none}
.glass{border-radius:20px;background:var(--glass);border:1px solid var(--outline);box-shadow:var(--shadow);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px)}
.topbar{position:fixed;z-index:20;top:15px;left:17px;right:17px;display:flex;align-items:center;gap:9px;pointer-events:none}.topbar>*{pointer-events:auto}
.round{display:flex;align-items:center;justify-content:center;border-radius:99px;padding:11px 16px;border-width:1px;font-size:13px;font-weight:700;white-space:nowrap}
.brand{padding:9px 16px;display:flex;align-items:center;gap:8px;border-radius:99px}.brand strong{font-size:15px}.brand span{font-size:12px;color:var(--muted)}.brand em{font-size:10px;color:#3b82f6;background:#e7f1ff;border-radius:99px;padding:3px 7px;font-style:normal}.topbar #theme{margin-left:auto}
#searchPanel{position:fixed;top:82px;bottom:78px;left:18px;width:300px;z-index:12;padding:17px;display:flex;flex-direction:column;gap:9px}
#searchPanel h2{font-size:18px;margin:0}#searchPanel p{font-size:12px;color:var(--muted);margin:0 0 2px}#search{border:1px solid #cfdae7;border-radius:12px;padding:12px;background:#ffffffed;width:100%;outline-offset:2px}
#results{overflow:auto;display:flex;flex-direction:column;gap:6px;min-height:0;flex:1}#results button{background:#ffffffb4;text-align:left;border:1px solid #d9e2ef;padding:10px 12px;border-radius:12px}#results button:hover{background:#e5f2ff;border-color:#7cb7fa}#results button small{font-size:11px;color:var(--muted);display:block;margin-top:2px}
#searchPanel>small{font-size:11px;color:var(--muted);line-height:1.6}
#detail{position:fixed;z-index:20;right:18px;top:82px;width:290px;max-height:70vh;padding:17px;overflow:auto}#detail[hidden]{display:none}.detail-heading{display:flex;justify-content:space-between;align-items:start;gap:9px}.detail-heading h2{font-size:17px;margin:0}.detail-heading button{border:0;background:#e9eef6;border-radius:10px;padding:6px 10px}
#detailMeta{font-size:12px;color:var(--muted);margin:10px 0;line-height:1.65}#shelfList{display:grid;gap:5px;margin:12px 0}#shelfList button{border:1px solid #d3e0ef;border-radius:10px;padding:9px 11px;text-align:left;background:#f4f8ff}#shelfList button.active{background:#d4e9ff;border-color:#3699fa}
.primary{background:#2879cf;border:0;color:white;border-radius:12px;font-weight:700;padding:11px 15px;width:100%}
#hint{position:fixed;top:82px;left:50%;transform:translateX(-50%);z-index:7;font-size:12px;color:white;background:#344154d9;border-radius:99px;padding:10px 16px;pointer-events:none;white-space:nowrap}
#controls{position:fixed;z-index:16;bottom:15px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:5px;padding:7px;border-radius:99px;max-width:96vw;overflow:auto}#controls button{white-space:nowrap;border:0;border-radius:99px;background:#edf3f9;padding:9px 12px;font-weight:700;font-size:12px}#controls button.active{background:#2b78c8;color:#fff}
#notice{display:none;position:fixed;z-index:40;bottom:78px;left:50%;transform:translateX(-50%);background:#1e293b;color:white;padding:12px 16px;border-radius:13px;font-size:12px;max-width:90vw}
body.dark{--ink:#f3f6fb;--muted:#b8c8d8;--glass:rgba(36,49,66,.90);--outline:rgba(255,255,255,.14);--shadow:0 12px 35px rgba(0,0,0,.3);background:#152131}
body.dark #search,body.dark #results button,body.dark #shelfList button,body.dark #controls button,body.dark .detail-heading button{background:#334960;color:#edf5ff;border-color:#4c6279}body.dark #results button small{color:#b8c8d8}body.dark #controls button.active{background:#286fbb}
@media(max-width:840px){#hint{display:none}.brand span{display:none}}
@media(max-width:680px){.topbar{top:8px;left:8px;right:8px;gap:4px}.round{padding:9px 10px;font-size:11px}.brand{padding:9px 10px}.brand strong{font-size:12px}.brand em{display:none}#searchPanel{top:63px;left:8px;bottom:auto;width:231px;max-height:211px;padding:11px;gap:5px}#searchPanel h2{font-size:14px}#searchPanel p{display:none}#search{padding:8px;font-size:12px}#results{max-height:89px;overflow:auto}#results button{padding:7px 9px;font-size:12px}#searchPanel>small{display:none}#detail{top:auto;right:8px;bottom:67px;max-height:37vh;width:min(284px,80vw);padding:12px}#controls{bottom:7px}#controls button{padding:8px 9px;font-size:11px}}
